{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Flow Desktop",
  "version": "1.3.1",
  "identifier": "com.skillflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skill Flow Desktop",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
